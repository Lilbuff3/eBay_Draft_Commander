# eBay Draft Commander — Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env

# === Required: eBay API Credentials ===
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_REFRESH_TOKEN=
EBAY_RU_NAME=

# === Required: Google Gemini API ===
GOOGLE_API_KEY=

# === Required: eBay Business Policies ===
# Run: python manage.py update_policies  to auto-fetch these
EBAY_FULFILLMENT_POLICY=
EBAY_PAYMENT_POLICY=
EBAY_RETURN_POLICY=
EBAY_MERCHANT_LOCATION=

# === Optional: Defaults ===
DEFAULT_CONDITION=USED_EXCELLENT
DEFAULT_PRICE=29.99
CONFIDENCE_THRESHOLD=85
AUTO_PUBLISH=false
AUTO_PUBLISH_MIN_PRICE=15.00
PORT=5000

# === Optional: Paths ===
# INBOX_PATH=C:\path\to\custom\inbox
# EBAY_ITEM_LOCATION=Clovis, CA
# EBAY_POSTAL_CODE=93611
