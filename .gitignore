# eBay Draft Commander - Git Ignore

# Environment variables (contains API keys!)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test/debug JSON output (not blanket *.json — that breaks config files)
data/*.json
tests/**/*.json
scripts/**/*.json
*.tmp.json

# Temporary files
*.tmp
*.temp
*.log
*.jsonl
debug_output*.txt
err.txt
lint-report*.txt

# Project specific noise
inbox/
data/inbox/
posted/
logs/
*.png
!frontend/public/logo.png  # Example: keep if there is a real logo

# Additional Debug & Test Outputs
*_output.txt
*_log.txt
debug_*.html
pricing_test.txt

# Frontend / Node
node_modules/
frontend/node_modules/
frontend/node_modules_trash/
*.db
*.db-shm
*.db-wal
frontend/dist/
frontend/dist-electron/
frontend/dist-python/
frontend/release/
.DS_Store
thumbs.db

# Backups
*.bak
*.bak2
*_backup*

# Logs and Debug
git_*.txt
*.log
logs/*.jsonl

# Tools archive
tools/archive/

# PyInstaller
*.spec

# PowerShell / Batch scripts (optional, but requested to utilize correct way)
# Keeping them if they are useful, but ignoring temporary ones
.claude/

# Large debug logs
backend_boot.log

# Tailscale TLS certs (sensitive!)
.certs/

# Auto-generated Caddyfile (created by start-https.ps1)
Caddyfile
